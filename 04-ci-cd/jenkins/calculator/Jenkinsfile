pipeline {
    agent any
    environment {
        JAVA_HOME = '/opt/java/jdk11'
    }
    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/adanoliva/bootcamp-devops.git', branch: 'main'
            }
        }
        stage('Compile') {
            steps {
                dir('04-ci-cd/jenkins/calculator') {
                    sh './gradlew compileJava'
                }
            }
        }
        stage('Unit Tests') {
            steps {
                dir('04-ci-cd/jenkins/calculator') {
                    sh './gradlew test'
                }
            }
        }
    }
}
